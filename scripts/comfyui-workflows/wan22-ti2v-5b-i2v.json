{
  "_meta": {
    "name": "WAN 2.2 TI2V-5B — Image-to-Video (5s @ 24fps)",
    "diffusion_model": "wan2.2_ti2v_5B_fp16.safetensors",
    "text_encoder": "umt5-xxl-encoder-Q4_K_M.gguf (via ComfyUI-GGUF CLIPLoaderGGUF)",
    "vae": "wan2.2_vae.safetensors",
    "comfyui_version_min": "0.18.1",
    "requires_custom_node": "city96/ComfyUI-GGUF (CLIPLoaderGGUF)",
    "note": "Separate UNETLoader+CLIPLoaderGGUF+VAELoader path. Avoids (a) the CheckpointLoaderSimple structure crash that killed LTX, and (b) the 'paging file too small' OOM loading the 6.7GB fp8 umt5 on this RAM-tight box (~7GB free) — the Q4_K_M GGUF encoder is only 3.65GB so it loads. TI2V-5B is the unified text+image-to-video model, no clip_vision needed.",
    "params": {
      "{{IMAGE}}":    "uploaded image filename (ComfyUI input/ dir)",
      "{{PROMPT}}":   "positive prompt — describe the desired scene",
      "{{NEGATIVE}}": "negative prompt (defaulted in script if blank)",
      "{{WIDTH}}":    "frame width (multiple of 16)",
      "{{HEIGHT}}":   "frame height (multiple of 16)",
      "{{LENGTH}}":   "frame count (4n+1, e.g. 121 ≈ 5s @ 24fps)",
      "{{FPS}}":      "output frames-per-second",
      "{{SEED}}":     "noise seed (int)",
      "{{PREFIX}}":   "SaveVideo filename prefix"
    }
  },
  "1": {
    "class_type": "UNETLoader",
    "inputs": { "unet_name": "wan2.2_ti2v_5B_fp16.safetensors", "weight_dtype": "default" }
  },
  "2": {
    "class_type": "CLIPLoaderGGUF",
    "inputs": { "clip_name": "umt5-xxl-encoder-Q4_K_M.gguf", "type": "wan" }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "wan2.2_vae.safetensors" }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "{{PROMPT}}", "clip": ["2", 0] }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "{{NEGATIVE}}", "clip": ["2", 0] }
  },
  "6": {
    "class_type": "LoadImage",
    "inputs": { "image": "{{IMAGE}}" }
  },
  "7": {
    "class_type": "Wan22ImageToVideoLatent",
    "inputs": {
      "vae": ["3", 0],
      "width": {{WIDTH}},
      "height": {{HEIGHT}},
      "length": {{LENGTH}},
      "batch_size": 1,
      "start_image": ["6", 0]
    }
  },
  "8": {
    "class_type": "ModelSamplingSD3",
    "inputs": { "model": ["1", 0], "shift": 8.0 }
  },
  "9": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["8", 0],
      "seed": {{SEED}},
      "steps": 30,
      "cfg": 5.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "positive": ["4", 0],
      "negative": ["5", 0],
      "latent_image": ["7", 0],
      "denoise": 1.0
    }
  },
  "10": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["9", 0], "vae": ["3", 0] }
  },
  "11": {
    "class_type": "CreateVideo",
    "inputs": { "images": ["10", 0], "fps": {{FPS}} }
  },
  "12": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["11", 0],
      "filename_prefix": "{{PREFIX}}",
      "format": "mp4",
      "codec": "h264"
    }
  }
}
