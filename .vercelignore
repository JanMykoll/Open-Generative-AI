# Vite SPA leftovers — this project is deployed as Next.js only on Vercel.
# The Vite path (vite.config.mjs, src/, index.html, dist/) is for the Electron build.
# Patterns are anchored to repo root so nested workspace package src/ / dist/ are kept.
/index.html
/dist/
/src/
/electron/
/release/
/.playwright-mcp/
/smoke-*.png
/bash.exe.stackdump

# Drop only node_modules from workspace packages — keep their dist/ (used as package main).
packages/*/node_modules/
packages/*/packages/*/node_modules/
